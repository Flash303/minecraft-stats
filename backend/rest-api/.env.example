# Configuration de la base de données
DATABASE_URL=postgres://my_user:my_password@localhost:5432/minecraft-stats

# Serveur
LISTEN_PORT=8080

# Authentification Clerk
CLERK_URL=https://your-clerk-url.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_your_secret_key

# Clé service pour les scripts admin (PATCH /admin/servers/bulk via `x-admin-key`).
# Longue durée de vie, à garder secrète. Sans elle, seul un JWT admin Clerk fonctionne.
ADMIN_API_KEY=change-me-to-a-long-random-secret

# Notifications Web Push (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_MAILTO=your_email@example.com

# URL de base de l'API
API_BASE_URL=https://api.mc-stats.fr

# Grafana stats
LOKI_URL=http://loki:3100/loki/api/v1/push